{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-greenhouse.example/contracts/cloud-edge/v1/schemas/error.schema.json",
  "title": "Cloud Edge error v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "error"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "gateway_not_found",
            "gateway_inactive",
            "point_not_found",
            "point_inactive",
            "gateway_point_forbidden",
            "telemetry_message_conflict",
            "command_not_found",
            "command_not_pending",
            "command_acknowledgement_conflict",
            "validation_error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "location",
              "message"
            ],
            "properties": {
              "location": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                }
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        }
      }
    }
  }
}
