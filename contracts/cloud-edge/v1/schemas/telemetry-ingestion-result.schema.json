{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-greenhouse.example/contracts/cloud-edge/v1/schemas/telemetry-ingestion-result.schema.json",
  "title": "Cloud Edge telemetry ingestion result v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "gateway_id",
    "results"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "gateway_id": {
      "type": "string",
      "format": "uuid"
    },
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message_id",
          "sample_id",
          "outcome",
          "received_at"
        ],
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid"
          },
          "sample_id": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "enum": [
              "recorded_current",
              "duplicate",
              "out_of_order"
            ]
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
