{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-greenhouse.example/contracts/cloud-edge/v1/schemas/command-acknowledgement.schema.json",
  "title": "Cloud Edge command acknowledgement v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "gateway_id",
    "command_id",
    "outcome",
    "acknowledged_at"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "gateway_id": {
      "type": "string",
      "format": "uuid"
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "outcome": {
      "enum": [
        "applied",
        "rejected"
      ]
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "rejected"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "reason"
        ]
      },
      "else": {
        "not": {
          "required": [
            "reason"
          ]
        }
      }
    }
  ]
}
